{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Ottie Executable",
      "type": "shell",
      "command": "go",
      "args": [
        "build",
        "-trimpath",
        "-ldflags=-s -w",
        "-o",
        "${workspaceFolder}/ottie.exe",
        "."
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Build & Run Ottie",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "."
      ],
      "group": "none",
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "go",
      "args": [
        "test",
        "-v",
        "./..."
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}
