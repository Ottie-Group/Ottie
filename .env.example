# Ottie Configuration
# (Optional) Static 32-byte base64 keys for session & cookie encryption persistence.
# If omitted, Ottie will auto-generate secure ephemeral keys in memory.
# Generate with: openssl rand -base64 32
APP_SESSION_KEY=
APP_SERVER_KEY=

# Local testing flag: set to 1 only when testing locally over plain HTTP without HTTPS/TLS
OTTIE_INSECURE_COOKIES=1

# Custom DB path (default ./data/ottie.db)
OTTIE_DB_PATH=./data/ottie.db

# Listen address (default 127.0.0.1:8080)
OTTIE_LISTEN_ADDR=127.0.0.1:8080

# Optional 2FA Delivery Providers (Enable in Settings)
# Email (SMTP): Configure to enable Email 2FA OTP codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS Gateway to enable SMS 2FA OTP codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
