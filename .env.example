# Ottie Configuration
# (Optional) Static 32-byte base64 keys for session & cookie encryption persistence.
# If omitted, Ottie will auto-generate secure ephemeral keys in memory.
# Generate with: openssl rand -base64 32
APP_SESSION_KEY=
APP_SERVER_KEY=

# Local testing flag: set to 1 only when testing locally over plain HTTP without HTTPS/TLS
OTTIE_INSECURE_COOKIES=1

# Enable verbose session & authentication diagnostic logs (0 = disabled, 1 = enabled)
OTTIE_DEBUG_LOGS=0

# Session / Cookie Lifetime (default: 7d or 604800s; supports "7d", "24h", "168h", or integer seconds)
OTTIE_SESSION_MAX_AGE=7d

# Custom DB path (default ./data/ottie.db)
OTTIE_DB_PATH=./data/ottie.db

# Listen address (default 127.0.0.1:8080)
OTTIE_LISTEN_ADDR=127.0.0.1:8080

# Optional 2FA Delivery Providers (Enable in Settings)
# Email (SMTP): Configure to enable Email 2FA OTP codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS 2FA Delivery Providers: Choose SMSGate (FOSS / Android Gateway) OR Twilio
# Option A: SMSGate (https://sms-gate.app/ - Cloud or Self-Hosted Android SMS Gateway)
# SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1/messages  # Default cloud or e.g. http://192.168.1.50:8080/3rdparty/v1/messages
SMSGATE_LOGIN=
SMSGATE_PASSWORD=
# Or use Bearer token instead of login/password:
# SMSGATE_TOKEN=

# Option B: Twilio SMS Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
